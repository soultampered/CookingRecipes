PORT=3000
MONGO_URI=mongodb://user:password@locokalhost:27017/recipe-app?authSource=admin
JWT_SECRET=changeme
# STO-119 release flags: the GrowthBook SDK key for the `dev` environment. Without it every
# flag is off; FEATURES_ALL_ON=1 turns them all on for local development instead.
GROWTHBOOK_CLIENT_KEY=
FEATURES_ALL_ON=1
# Set during a JWT_SECRET rotation only — see api/src/services/jwtSecrets.ts. Omit otherwise.
JWT_SECRET_PREVIOUS=
RESEND_API_KEY=changeme
# Local dev only: set to 1 to print emails (codes) to the console instead of sending.
EMAIL_DEV_LOG=
# Comma-separated. Omit to use the built-in Capacitor/dev-origin defaults (see api/src/index.ts).
CORS_ORIGIN=
